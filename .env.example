# Copy to .env and replace every change-me value.
# Do not commit .env. These are development placeholders, not production secrets.

POSTGRES_DB=collabdocs
POSTGRES_USER=collabdocs
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=collabdocs
MINIO_ROOT_PASSWORD=change-me-minio

# Shared by the worker and the compactor. Not a user password.
INTERNAL_TOKEN=change-me-internal

ALLOWED_ORIGINS=http://localhost:8080

# PEM values are required once authentication is implemented.
# Generate them inside a container. See docs/08-devops/DEVOPS.md.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Optional. Leave empty in development.
OTEL_EXPORTER_OTLP_ENDPOINT=
