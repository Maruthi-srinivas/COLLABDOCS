{
  "uid": "collabdocs",
  "title": "CollabDocs",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "API p95", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_requests_seconds_bucket[5m])))", "refId": "A"}]},
    {"id": 2, "type": "timeseries", "title": "API error rate", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (route) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "refId": "A"}]},
    {"id": 3, "type": "timeseries", "title": "Ack p95", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(collab_update_ack_seconds_bucket[5m])))", "refId": "A"}]},
    {"id": 4, "type": "timeseries", "title": "Open sockets", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "collab_sockets_open", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Max snapshot lag", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "snapshot_lag_updates_max", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "Export queue depth and age", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "export_jobs", "refId": "A"}, {"expr": "export_queue_age_seconds", "refId": "B"}]},
    {"id": 7, "type": "timeseries", "title": "PostgreSQL connections and disk free", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "pg_stat_activity_count", "refId": "A"}, {"expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"}", "refId": "B"}]},
    {"id": 8, "type": "timeseries", "title": "Redis memory and ready checks", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "redis_memory_used_bytes", "refId": "A"}, {"expr": "db_up", "refId": "B"}, {"expr": "redis_up", "refId": "C"}, {"expr": "ready_check_failures_total", "refId": "D"}]}
  ]
}
